NEXT_PUBLIC_CONTACT_PHONE=424-250-9420
NEXT_PUBLIC_CONTACT_EMAIL=Cassedani@gmail.com

# Production database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Keep true in production so public visitors cannot create owner accounts.
# Temporarily set to false only while creating the first owner account, then set it back to true.
AUTH_DISABLE_SIGNUP=true
